# =============================================================================
# LabelAlly Entertainment - Contact API Environment Configuration Template
# =============================================================================
# LOCAL DEVELOPMENT: Copy this file to .env.local (kept git-ignored)
# PRODUCTION: Configure in your hosting platform (Vercel Project Settings -> Environment Variables)
# =============================================================================

# 1. Allowed Origins (comma-separated list for CORS/origin validation)
# - Local dev automatically includes: http://localhost:5173, http://127.0.0.1:5173
# - Production (Vercel):
ALLOWED_ORIGINS=https://labelally.in,https://www.labelally.in

# 2. Email Service Provider: 'resend' or 'brevo'
EMAIL_PROVIDER=resend

# 3. Email Provider Secret API Key (server-side only; never expose to client / VITE_ prefix)
# - Resend: https://resend.com/api-keys (key begins with 're_')
# - Brevo:  https://app.brevo.com/settings/keys/api (key begins with 'xkeysib-')
EMAIL_API_KEY=your_resend_api_key_here

# 4. Recipient Email (where partner enquiries submitted via the form will be delivered)
# - Local testing: your Resend registered account email (e.g. labelally86@gmail.com)
# - Production: your business enquiry mailbox
CONTACT_EMAIL_TO=business@labelally.in

# 5. Sender Email Address ('From' header)
# - Local testing (Resend sandbox): onboarding@resend.dev (delivers only to account owner)
# - Production (requires verified domain in Resend): "LabelAlly Entertainment <business@labelally.in>"
CONTACT_EMAIL_FROM="LabelAlly Entertainment <business@labelally.in>"
